# Deployed by .github/workflows/deploy.yml; this file replaces the server's copy.
# Serve the static site at / (a legacy WordPress install still lives in public_html).
DirectoryIndex index.html

# Always serve over HTTPS (forms post to enviar.php and must stay encrypted).
# AutoSSL's domain validation path is left alone so certificate renewals keep working.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Hide the legacy WordPress install and the FTP deploy state file.
RedirectMatch 404 ^/(wp-admin|wp-content|wp-includes|wp-json)(/|$)
RedirectMatch 404 ^/(index|xmlrpc|wp-[a-z-]+)\.php$
RedirectMatch 404 ^/(readme\.html|license\.txt|wp-config-sample\.php|error_log|.*\.zip|index\.html_)$
RedirectMatch 404 ^/\.ftp-deploy-sync-state\.json$

# The data-protection page was merged into the combined privacy policy.
RedirectMatch 301 ^/proteccion-de-datos-personales\.html$ /politicas-de-privacidad.html
